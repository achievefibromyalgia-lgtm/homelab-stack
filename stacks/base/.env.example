# =============================================================================
# HomeLab Stack — Base Infrastructure Environment
# =============================================================================

# Domain
DOMAIN=homelab.local

# Timezone
TZ=Asia/Singapore

# Traefik — HTTPS Certificate
ACME_EMAIL=admin@homelab.local

# Traefik Dashboard — BasicAuth
# Generate: htpasswd -nb admin YOUR_PASSWORD | sed 's/$/$$/g'
# Example: TRAEFIK_AUTH=admin:$apr1$rHW6$Wbw9V0z8mV2Q6jXqT.X9L/
TRAEFIK_AUTH=

# Watchtower Notifications (optional)
# Example: ntfy URL for update alerts
# WATCHTOWER_NOTIFICATION_URL=http://ntfy:80/watchtower
WATCHTOWER_NOTIFICATION_URL=